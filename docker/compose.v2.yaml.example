# Sonarly v2 (Go rewrite) — compose example.
#
# Copy to compose.yaml (gitignored at the repo root) and adjust. This is the
# v2 equivalent of the v1 service in docker/compose.yaml.example: same host
# paths, same port mapping, v2 env names. The image builds from the repo
# root context (docker/Dockerfile.v2).
#
# Cutover from v1: keep ./config/sonarly/data mounted — v2's baseline
# migration is CREATE-IF-NOT EXISTS over the exact v1 schema, so the v1 DB
# file is used in place; no export/import step. See
# docs/v2-cutover-readiness.md for the full runbook and rollback.

services:
  sonarly:
    image: ghcr.io/miquelrosell99/sonarly:v2
    build:
      context: .
      dockerfile: docker/Dockerfile.v2
      args:
        # Injected into the binary via -ldflags -X buildinfo.Version
        # (reported by the OpenSubsonic serverVersion field).
        SONARLY_VERSION: ${SONARLY_VERSION:-0.0.0-dev}
    container_name: sonarly
    ports:
      - "${SONARLY_PORT:-4533}:3000"
    volumes:
      # SQLite DB + server state (artist images, uploads). Same host path as
      # v1 — the v1 DB file lives directly inside and is opened in place.
      - ./config/sonarly/data:/data/db
      # Drop folder for ingest.
      - ${SONARLY_INGEST_PATH:-./config/sonarly/ingest}:/data/ingest
      # The music library. Read-only is sufficient for scanning/streaming;
      # tag editing and organize need write access.
      - ${LIBRARY_MUSIC:-./config/sonarly/library}:/media/music
    environment:
      - SONARLY_ADDR=:3000
      # Keep the v1 value: it seals users.subsonic_password_encrypted and
      # signs sessions — changing it logs everyone out and breaks Subsonic
      # client passwords.
      - SESSION_SECRET=${SESSION_SECRET}
      - SESSION_COOKIE_SECURE=${SESSION_COOKIE_SECURE:-false}
      - SONARLY_DB_PATH=/data/db/sonarly.db
      - SONARLY_DATA_DIR=/data/db
      - SONARLY_LIBRARY_PATH=/media/music
      - SONARLY_INGEST_PATH=/data/ingest
      # Built web client baked into the image; only override to serve a
      # custom build. A missing directory puts the server in API-only mode.
      - SONARLY_WEB_DIST=/app/web-dist
      # v1 cadence (the image defaults already match these).
      - SONARLY_SCAN_INTERVAL_MINUTES=60
      - SONARLY_WATCH_POLL_INTERVAL=5
      - SONARLY_ARTIST_IMAGE_INTERVAL_MINUTES=1440
      - SONARLY_INGEST_INTERVAL_MINUTES=60
      - PUID=${PUID:-1000}
      - PGID=${PGID:-1000}
    restart: unless-stopped
