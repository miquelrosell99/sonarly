FROM node:20-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

# Native dependencies (bcrypt, better-sqlite3) need a compiler and Python.
RUN apk add --no-cache python3 make g++

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/web/package.json packages/web/

RUN pnpm install --frozen-lockfile

COPY packages/shared packages/shared
COPY packages/server packages/server
COPY packages/web packages/web

RUN pnpm -r build

# Produce a self-contained production node_modules tree for the server.
RUN pnpm --filter @sonarly/server deploy --prod /app/standalone

FROM node:20-alpine AS runner

# Runtime tooling for the scanner/tag writer and audio transcoding.
# su-exec is used by the entrypoint to drop privileges after adjusting UID/GID.
RUN apk add --no-cache python3 py3-pip ffmpeg libstdc++ su-exec \
  && pip3 install --no-cache-dir mutagen==1.48.1 --break-system-packages

WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/standalone/dist ./dist
COPY --from=builder /app/standalone/package.json ./
COPY --from=builder /app/standalone/node_modules ./node_modules
COPY --from=builder /app/packages/web/dist ./web-dist
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# The base image already provides a non-root `node` user/group with uid/gid 1000.
# The entrypoint adjusts this at runtime based on PUID/PGID and drops privileges.
RUN chown -R node:node /app

EXPOSE 3000

ENTRYPOINT ["/entrypoint.sh"]
