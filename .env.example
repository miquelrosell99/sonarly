# Copy this file to .env and customize the values.
# SESSION_SECRET must be at least 32 characters and should be changed in production.
# Generate a strong secret with: openssl rand -hex 32
# It seals the Subsonic password column and signs session cookies — changing it
# logs everyone out and breaks existing Subsonic client passwords.
SESSION_SECRET=change-me-in-production-to-a-secret-key-with-at-least-32-chars

# Server tuning (all optional; see docs/deployment.md for the full list).
# The SONARLY_* variables below are the compose-level overrides of the image
# defaults — set them here only if you want different values.
# SONARLY_SCAN_INTERVAL_MINUTES=60
# SONARLY_WATCH_POLL_INTERVAL=5
# SONARLY_ARTIST_IMAGE_INTERVAL_MINUTES=1440
# SONARLY_INGEST_INTERVAL_MINUTES=60
# SONARLY_REVIEW_RETENTION_DAYS=30
# SONARLY_TRANSCODE_CONCURRENCY=2
# Optional: allow visitors to create their own accounts from the login
# screen (POST /api/signup + /signup). Off by default and when unset;
# signups create regular users with no library assignment until an admin
# scopes one.
# SONARLY_SIGNUP_ENABLED=false

# Optional: comma-separated list of hosts the Vite dev server is allowed to respond to.
# If unset, only localhost is allowed. Use 'true' to allow all hosts (not recommended outside trusted networks).
# SONARLY_DEV_ALLOWED_HOSTS=

# Optional: host paths for admin-managed libraries, mounted under /media in the container.
# Use LIBRARY_MUSIC for the main music library (mounted at /media/music).
# Additional libraries can be added by editing compose.yaml (copy
# docker/compose.yaml.example first; e.g. /srv/.../Audiobooks:/media/audiobooks)
# and creating them in the admin panel.
LIBRARY_MUSIC=/path/to/music

# Optional: host path for the SQLite DB + server state (artist images, uploads).
# Defaults to ./config/sonarly/data (repo-local). Fleet hosts keeping the live
# DB at the managed stacks location set an absolute path here so the bind
# resolves identically no matter which folder the compose runs from:
# SONARLY_DATA_DIR=/etc/periphery/stacks/sonarly/config/sonarly/data
# Optional: host path for the ingest/review folder (bind-mounted to
# /data/ingest; keep it absolute on fleet hosts, where the compose runs from
# the checkout but the data stays in the stacks folder).
# SONARLY_INGEST_PATH=./config/sonarly/ingest
