# Copy this file to .env and customize the values.
# SESSION_SECRET must be at least 32 characters and should be changed in production.
# Generate a strong secret with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production-to-a-secret-key-with-at-least-32-chars

# Optional: default retention period for files in the ingest review folder (days).
# Can be changed later in the web UI settings. Defaults to 30.
# REVIEW_RETENTION_DAYS=30

# Optional: how often to sync artist images from an external provider (minutes).
# Set to 0 to disable. Defaults to 1440 (24 hours).
# ARTIST_IMAGE_INTERVAL_MINUTES=1440

# Optional: how often to process files in the ingest folder (minutes).
# Set to 0 to disable. Defaults to 60 (1 hour).
# INGEST_INTERVAL_MINUTES=60

# Optional: comma-separated list of hosts the Vite dev server is allowed to respond to.
# If unset, only localhost is allowed. Use 'true' to allow all hosts (not recommended outside trusted networks).
# SONARLY_DEV_ALLOWED_HOSTS=

# Optional: host paths for admin-managed libraries, mounted under /media in the container.
# Use LIBRARY_MUSIC for the main music library (mounted at /media/music).
# Additional libraries can be added by editing compose.yaml or compose.dev.yaml
# (copy docker/compose.dev.yaml.example first; e.g. /srv/.../Audiobooks:/media/audiobooks)
# and creating them in the admin panel.
LIBRARY_MUSIC=/path/to/music

# Optional: host path for the ingest/review folder.
# Defaults to ./config/sonarly/ingest. The path is bind-mounted to /data/ingest in the container.
# SONARLY_INGEST_PATH=./config/sonarly/ingest
