services:
  sonarly:
    image: ghcr.io/miquelrosell99/sonarly:${SONARLY_VERSION:-latest}
    build:
      context: .
      dockerfile: docker/Dockerfile.server
    container_name: sonarly
    ports:
      - "${SONARLY_PORT:-4533}:3000"
    volumes:
      - ./config/sonarly/data:/data/db
      - ${SONARLY_INGEST_PATH:-./config/sonarly/ingest}:/data/ingest
      - ${LIBRARY_MUSIC:-./config/sonarly/library}:/media/music
    environment:
      - PORT=3000
      - NODE_ENV=production
      - SESSION_SECRET=${SESSION_SECRET}
      - SESSION_COOKIE_SECURE=${SESSION_COOKIE_SECURE:-false}
      - DATA_DIR=/data/db
      - INGEST_PATH=/data/ingest
      - LIBRARY_PATH=/media/music
      - SCAN_INTERVAL_MINUTES=60
      - WATCHER_USE_POLLING=${WATCHER_USE_POLLING:-false}
      - PUID=${PUID:-1000}
      - PGID=${PGID:-1000}
    restart: unless-stopped
